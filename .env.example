# Informational default; the actual provider used for a run is chosen per
# request via --llm/"llm" on the CLI/API ("scripted" needs no key at all,
# "real" calls out to whichever key below matches LLM_MODEL's provider).
LLM_PROVIDER=scripted
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent loop limits
MAX_STEPS=10
MAX_RUN_SECONDS=60
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=2
LLM_MAX_RETRIES=3
LLM_MAX_REPAIR=2

# Storage
DATABASE_URL=sqlite:///./harness.db

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# Data files (mock dataset)
DATA_DIR=./data
